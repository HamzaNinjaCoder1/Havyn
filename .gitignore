# Python cache — matches in ALL subdirectories
**/__pycache__/
*.pyc
*.pyo
*.pyd

# Tests & coverage
.pytest_cache/
.coverage
htmlcov/

# Build & packaging
*.egg-info/
dist/
build/
*.egg

# Virtual environments
.venv/
venv/
env/

# EXTENSION/script-engine: only main.js is our own code (bridge, token,
# installMcpHelpers). The rest are reference copies of PTBuilder's script engine
# (kimmknight/PTBuilder, credited in the README) — not redistributed here.
EXTENSION/script-engine/*.js
!EXTENSION/script-engine/main.js

# macOS
.DS_Store


# Generated runtime artifacts
data/
tmp/
.audit-tmp/
autopilot_evidence/
examples/phase2/evidence/

CLAUDE.md
# Project exports / generated topology artifacts (runtime output, not source)
projects/
output/

# Tooling
.claude/
.vscode/settings.json
*.log

# Large demo media (README embeds the GIF; keep heavy video out of git)
demo/*.mp4

# MkDocs build output
site/
_site/

pt_union.txt

# Local working documents (evaluation trackers, not product source)
ISSUES.md
QA_REPORT.md
*.docx
# The blueprint is committed at docs/roadmap/havyn-production-blueprint.html;
# this is the untracked working copy of the same file.
Havyn_Production_Tracking.html

# S1.12 catalog probe output and S1.19 runner results are generated artifacts
probe.json
runner_s119/results/
# Per-machine nightly queue (absolute spec paths; generated by make_queue.py)
scripts/nightly/nightly-queue.json
# Per-run one-case queues and Tee-Object console captures. The gate summary
# (runner_s119/s119-gate-summary.json) is the committed evidence and names them.
runner_s119/gate-logs/

# S2.2/S2.5 runtime output: the runner's per-case results and the fault lab's
# evidence are per-machine run artifacts. What gets published is the scorecard
# (docs/reports/), generated FROM these — never the raw run files themselves.
runner_results/
fault_lab_results/

# Throwaway PT-debugging probes (underscore-prefixed) and the console captures
# they print. `scripts/audit_routes.py` and the other non-underscore scripts are
# real deliverables and stay tracked.
scripts/_*
Prompt.txt
fwbr_js.txt
live*_out.txt
live*_err.txt
live*_pid.txt

# Per-machine CodeBuddy overrides (documented as not-for-git local scope)
.codebuddy/settings.local.json

# Stage 4 live backup artifacts (contain user workspace copies)
probes/stage4-backups/

# Secrets and tokens: never commit, never write into Drive notebooks
.env
.env.*
secrets/
hf_token
hf_token.txt
*.pem
*.key

havyn-stage5/runs/

# Stage 5 runtime artifacts (Colab / Drive outputs, not source)
havyn-stage5/artifacts/
havyn-stage5/checkpoints/
havyn-stage5/evaluation/
havyn-stage5/bakeoff/
havyn-stage5/improvement/
havyn-stage5/datasets/hf-export/
