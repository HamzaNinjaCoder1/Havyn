<?xml version="1.0" encoding="UTF-16"?>
<!--
  Havyn nightly task (S2.3): import once as admin, then it runs itself.

    schtasks /create /tn "HavynNightly" /xml "scripts\nightly\havyn-nightly.xml"

  Runs daily at 02:00 as the interactive user (Packet Tracer needs a desktop
  session), wakes the machine, and stops if it runs past 06:00. Power and
  notification setup are one-time manual steps, see docs/nightly-setup.md.
-->
<Task version="1.2" xmlns="http://schemas.microsoft.com/windows/2004/02/mit/task">
  <RegistrationInfo>
    <Description>Havyn nightly: Packet Tracer up, topology library build, PT down.</Description>
  </RegistrationInfo>
  <Triggers>
    <CalendarTrigger>
      <StartBoundary>2026-10-01T02:00:00</StartBoundary>
      <ScheduleByDay>
        <DaysInterval>1</DaysInterval>
      </ScheduleByDay>
    </CalendarTrigger>
  </Triggers>
  <Principals>
    <Principal id="InteractiveUser">
      <LogonType>InteractiveToken</LogonType>
      <RunLevel>HighestAvailable</RunLevel>
    </Principal>
  </Principals>
  <Settings>
    <MultipleInstancesPolicy>IgnoreNew</MultipleInstancesPolicy>
    <DisallowStartIfOnBatteries>false</DisallowStartIfOnBatteries>
    <StopIfGoingOnBatteries>false</StopIfGoingOnBatteries>
    <AllowHardTerminate>true</AllowHardTerminate>
    <StartWhenAvailable>true</StartWhenAvailable>
    <RunOnlyIfNetworkAvailable>false</RunOnlyIfNetworkAvailable>
    <WakeToRun>true</WakeToRun>
    <ExecutionTimeLimit>PT4H</ExecutionTimeLimit>
    <Priority>7</Priority>
  </Settings>
  <Actions Context="InteractiveUser">
    <Exec>
      <Command>powershell.exe</Command>
      <Arguments>-NoProfile -ExecutionPolicy Bypass -File "%REPOROOT%\scripts\nightly\havyn-nightly.ps1"</Arguments>
      <WorkingDirectory>%REPOROOT%</WorkingDirectory>
    </Exec>
  </Actions>
</Task>
