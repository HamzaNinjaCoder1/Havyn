  "subnets": [
    {
      "id": "wan",
      "cidr": "10.0.0.0/30"
    },
    {
      "id": "lan1",
      "cidr": "10.0.1.0/24"
    },
    {
      "id": "lan2",
      "cidr": "10.0.2.0/24"
    }
  ],
  "ip_assignments": [
    {
      "device": "r1",
      "subnet": "wan",
      "ip": "10.0.0.1"
    },
    {
      "device": "r2",
      "subnet": "wan",
      "ip": "10.0.0.2"
    },
    {
      "device": "r1",
      "subnet": "lan1",
      "ip": "10.0.1.1"
    },
    {
      "device": "r2",
      "subnet": "lan2",
      "ip": "10.0.2.1"
    },
    {
      "device": "pc1",
      "subnet": "lan1"
    },
    {
      "device": "pc2",
      "subnet": "lan2"
    }
  ],
  "routing": {
    "mode": "eigrp",
    "eigrp": {
      "as_number": 10,
      "networks": [
        "10.0.0.0/30",
        "10.0.1.0/24",
        "10.0.2.0/24"
      ]
    }
  },
  "requirements": [
    {
      "id": "R-1",
      "statement": "Every LAN reaches every other LAN"
    }
  ],
  "acceptance_criteria": [
    {
      "id": "A-1",
      "requirement_ids": [
        "R-1"
      ],
      "test": {
        "kind": "flow",
        "source": "pc1",
        "destination": "pc2",
        "expect": "reachable"
      }
    }
  ],
  "description": "Stage 3 live lab: S3-A3-eigrp"
}