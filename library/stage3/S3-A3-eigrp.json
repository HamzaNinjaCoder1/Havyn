    {
      "id": "r1",
      "role": "router"
    },
    {
      "id": "r2",
      "role": "router"
    },
    {
      "id": "s1",
      "role": "switch"
    },
    {
      "id": "s2",
      "role": "switch"
    },
    {
      "id": "pc1",
      "role": "pc"
    },
    {
      "id": "pc2",
      "role": "pc"
    }
  ],
  "links": [
    {
      "id": "l-r1-r2",
      "a": {
        "device": "r1"
      },
      "b": {
        "device": "r2"
      }
    },
    {
      "id": "l-r1-s1",
      "a": {
        "device": "r1"
      },
      "b": {
        "device": "s1"
      }
    },
    {
      "id": "l-r2-s2",
      "a": {
        "device": "r2"
      },
      "b": {
        "device": "s2"
      }
    },
    {
      "id": "l-s1-pc1",
      "a": {
        "device": "s1"
      },
      "b": {
        "device": "pc1"
      }
    },
    {
      "id": "l-s2-pc2",
      "a": {
        "device": "s2"
      },
      "b": {
        "device": "pc2"
      }
    }
