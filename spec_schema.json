{
 "$defs": {
  "AcceptanceCriterionSpec": {
   "additionalProperties": false,
   "description": "One checkable criterion, linked back to the requirements it verifies.",
   "properties": {
    "id": {
     "title": "Id",
     "type": "string"
    },
    "requirement_ids": {
     "items": {
      "type": "string"
     },
     "title": "Requirement Ids",
     "type": "array"
    },
    "test": {
     "discriminator": {
      "mapping": {
       "config": "#/$defs/ConfigTestSpec",
       "flow": "#/$defs/FlowTestSpec",
       "structural": "#/$defs/StructuralTestSpec",
       "wireless": "#/$defs/WirelessTestSpec"
      },
      "propertyName": "kind"
     },
     "oneOf": [
      {
       "$ref": "#/$defs/FlowTestSpec"
      },
      {
       "$ref": "#/$defs/StructuralTestSpec"
      },
      {
       "$ref": "#/$defs/ConfigTestSpec"
      },
      {
       "$ref": "#/$defs/WirelessTestSpec"
      }
     ],
     "title": "Test"
    },
    "title": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Title"
    }
   },
   "required": [
    "id",
    "test"
   ],
   "title": "AcceptanceCriterionSpec",
   "type": "object"
  },
  "AclRuleSpec": {
   "additionalProperties": false,
   "properties": {
    "action": {
     "enum": [
      "permit",
      "deny"
     ],
     "title": "Action",
     "type": "string"
    },
    "protocol": {
     "default": "ip",
     "enum": [
      "ip",
      "icmp",
      "tcp",
      "udp"
     ],
     "title": "Protocol",
     "type": "string"
    },
    "source": {
     "title": "Source",
     "type": "string"
    },
    "destination": {
     "title": "Destination",
     "type": "string"
    },
    "dest_port": {
     "anyOf": [
      {
       "maximum": 65535,
       "minimum": 1,
       "type": "integer"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Dest Port"
    },
    "description": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Description"
    }
   },
   "required": [
    "action",
    "source",
    "destination"
   ],
   "title": "AclRuleSpec",
   "type": "object"
  },
  "AsaInterfaceSpec": {
   "additionalProperties": false,
   "description": "One ASA interface, as the spec wants it named and levelled (#37).\n\nPT's ASA assigns `inside`/`security-level 100` to the first interface and\n`outside`/`0` to the second, so a design that needs a third zone - a DMZ,\nsay - had nowhere to say so. Naming an interface here overrides the\nderived nameif and level; the address still comes from `ip_assignments`,\nbecause that is where the subnet lives.",
   "properties": {
    "interface": {
     "minLength": 1,
     "title": "Interface",
     "type": "string"
    },
    "nameif": {
     "maxLength": 64,
     "pattern": "^[a-z][a-z0-9_]*$",
     "title": "Nameif",
     "type": "string"
    },
    "security_level": {
     "maximum": 100,
     "minimum": 0,
     "title": "Security Level",
     "type": "integer"
    }
   },
   "required": [
    "interface",
    "nameif",
    "security_level"
   ],
   "title": "AsaInterfaceSpec",
   "type": "object"
  },
  "ConfigTestSpec": {
   "additionalProperties": false,
   "description": "A configuration expectation on one field of one interface.",
   "properties": {
    "kind": {
     "const": "config",
     "default": "config",
     "title": "Kind",
     "type": "string"
    },
    "device": {
     "title": "Device",
     "type": "string"
    },
    "interface": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Interface"
    },
    "field": {
     "enum": [
      "ip",
      "mask",
      "vlan",
      "state",
      "description"
     ],
     "title": "Field",
     "type": "string"
    },
    "expected": {
     "title": "Expected",
     "type": "string"
    }
   },
   "required": [
    "device",
    "field",
    "expected"
   ],
   "title": "ConfigTestSpec",
   "type": "object"
  },
