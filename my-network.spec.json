 "assumptions": [
  "ISP router needs no NAT because it has a return route to 10.0.0.0/8.",
  "Wireless laptops are associated after the build with associate_wireless_client."
 ],
 "design_decisions": [
  {
   "id": "D-001",
   "statement": "Router-on-a-stick on rhq GigabitEthernet0/0 for VLANs 10, 20, 30.",
   "rationale": "Proven inter-VLAN pattern; one trunk to the distribution switch carries all HQ VLANs.",
   "source": "user"
  },
  {
   "id": "D-002",
   "statement": "Three firewall zones: HQ perimeter (fwhq), data center (fwdc), branch (fwbr).",
   "rationale": "Defense in depth: servers and branch are each behind their own ASA.",
   "source": "user"
  },
  {
   "id": "D-003",
   "statement": "Static routing with summarised /16 routes per site.",
   "rationale": "Deterministic, fully verifiable paths across ASAs, which do not take part in dynamic routing here.",
   "source": "user"
  },
  {
   "id": "D-004",
   "statement": "/30 transit networks for every point-to-point link, /24 per user or server segment.",
   "source": "user"
  },
  {
   "id": "D-005",
   "statement": "IoT Smart LEDs are cabled without IP configuration.",
   "rationale": "Smart LED is the only live-verified cablable IoE thing; it is provisioned by an IoT server, so a desktop IP op would be meaningless.",
   "source": "user"
  },
  {
   "id": "D-006",
   "statement": "Linksys WRT300N is cabled by the port solver without hints; laptops lap4/lap5 join it wirelessly.",
   "rationale": "Matches the engine's live-verified 63-device build pattern.",
   "source": "user"
  },
  {
   "id": "D-007",
   "statement": "The ISP uplink is a direct fwhq<->risp cable: PT's Cloud-PT DSL pass-through cannot be driven from the scripting API, so the Cloud and DSL modem are not used.",
   "source": "user",
   "rationale": "A direct link is deterministic and fully verifiable; the Cloud-PT needs a GUI-only DSL mapping row."
  }
 ],
 "constraints": [
  "ASA policies are protocol-scoped here; address-scoped ASA ACLs ARE enforced by PT (S1.16 live A/B/C) and are available to specs that need them.",
  "Serial link uses Router-PT built-in Serial2/0 ports."
 ],
 "layout_seed": 42
