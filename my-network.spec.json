{
 "spec_version": "1",
 "name": "enterprise-campus-eval",
 "description": "Multi-site enterprise network: HQ campus with router-on-a-stick inter-VLAN routing (VLAN 10/20/30) and DHCP, perimeter + data-center + branch ASA firewalls, branch office over a serial DCE WAN link, Internet via a direct fwhq-risp WAN link, VLANs 10/20/30 with DHCP, IoT switch, wireless router with wireless laptops. 4 routers, 3 ASA, 6 switches, 16 PCs, 5 laptops, 5 IoT, 3 servers.",
 "provenance": {
  "author": "user",
  "generator": "network_autopilot",
  "source_prompt": "Complex production-level evaluation network: 16 PCs, 5 laptops, 3 ASA, 1 wireless router, IoT devices, multiple routers and switches, serial DCE link, Cloud-PT, VLANs, full acceptance testing.",
  "notes": "Hand-authored typed spec. Every acceptance criterion traces to a requirement; negative (blocked) flows included."
 },
 "requirements": [
  {
   "id": "R-001",
   "statement": "HQ users on different floors communicate (inter-VLAN routing).",
   "kind": "connectivity"
  },
  {
   "id": "R-002",
   "statement": "HQ users and laptops reach data-center servers through the DC firewall.",
   "kind": "connectivity"
  },
  {
   "id": "R-003",
   "statement": "Branch office reaches HQ and the data center over the serial WAN link.",
   "kind": "connectivity"
  },
  {
   "id": "R-004",
   "statement": "All sites reach the Internet server through the perimeter firewall (fwhq) to the ISP router.",
   "kind": "connectivity"
  },
  {
   "id": "R-005",
   "statement": "IoT Smart LEDs are created and cabled on a dedicated IoT switch (PT IoE things are provisioned by an IoT server, not by desktop IP config).",
   "kind": "operational"
  },
  {
   "id": "R-006",
   "statement": "Only ICMP and HTTP are permitted through the firewalls; telnet is blocked.",
   "kind": "isolation"
  },
  {
   "id": "R-007",
   "statement": "Each HQ user group (floor-1, floor-2, laptops) has its own VLAN, carried on 802.1Q trunks.",
   "kind": "isolation"
  },
  {
   "id": "R-008",
   "statement": "HQ users get addressing via DHCP; servers, IoT and infrastructure are static.",
   "kind": "addressing"
  },
  {
   "id": "R-009",
   "statement": "Wireless laptops associate to the HQ wireless router.",
   "kind": "connectivity"
  },
  {
   "id": "R-010",
   "statement": "Perimeter ASA passes inside-initiated flows and blocks outside-initiated flows (S1.16 live-proven).",
   "kind": "isolation"
  }
 ],
